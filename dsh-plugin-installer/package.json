{
  "name": "dsh-plugin-installer",
  "version": "0.2.0",
  "description": "DSH 辅助插件：全自动安装 DSH 插件（npm 包/本地目录/本地压缩包/远程压缩包/git 五种来源），诊断是辅助能力",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugin-installer",
    "plugin-manager",
    "npm",
    "pnpm",
    "typescript",
    "agent",
    "tool"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "@vitest/utils": "^4.1.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node test/smoke.mjs",
    "e2e": "node test/e2e.mjs",
    "e2e-sources": "node test/e2e-sources.mjs",
    "acceptance": "node test/acceptance.mjs",
    "verify-profile": "node test/verify-profile-resolution.mjs"
  }
}